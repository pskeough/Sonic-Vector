# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env
ENV/

# Configuration and Credentials
config.yaml

# Spotify Token Caching and playback state caches
data/spotify_tokens.json
.spotify_cache

# Local user-specific songs database (caching manual adjustments)
data/songs.db

# Logs and system backups
logs/
*.log
data/config.txt

# Derived/synthetic data artifacts (rebuild with preprocess_safe.py)
data/synthetic_priors.MOCK.csv
data/test_library.db
data/SAFEEqualiserUserData.csv

# Rotated logs. The `*.log` rule above does not catch these: logging's
# RotatingFileHandler appends the index AFTER the extension, so the rotated
# files are sonicvector.log.1, .log.2 and so on. Half a megabyte each of
# request noise and listening history.
*.log.*

# Personal EQ preference votes. Local to whoever is running it.
data/preferences.db
